{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit current-interface connectivity probe",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "confirmed"],
  "properties": {
    "request_id": {"type": "string", "pattern": "^(?:[0-9a-fA-F]{32}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"},
    "confirmed": {"const": true}
  }
}
