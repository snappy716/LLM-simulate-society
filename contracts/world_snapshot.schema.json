{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-simulate-society.local/contracts/world_snapshot.schema.json",
  "title": "Godot world snapshot",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "revision", "day", "weekday", "phase", "busy", "player_scene", "player", "items", "item_uses", "item_instances", "scene_inventories", "container_inventories", "passages", "available_actions", "player_intelligence", "shops", "peer_trade_offers", "recent_trade_memories", "scenes", "npcs", "new_events"],
  "properties": {
    "schema_version": {"const": 2},
    "revision": {"type": "integer", "minimum": 1},
    "day": {"type": "integer", "minimum": 1},
    "weekday": {"type": "integer", "minimum": 0, "maximum": 6},
    "phase": {"enum": ["morning", "afternoon", "evening", "late_night"]},
    "busy": {"type": "boolean"},
    "player_scene": {"type": "string"},
    "player": {
      "type": "object",
      "required": ["id", "wealth", "health", "sanity", "states", "item_effects", "item_effect_records", "equipped_item_ids", "equipment_slots", "knowledge", "skills", "currency", "inventory_weight", "inventory_capacity", "inventory"],
      "properties": {
        "id": {"const": "player"},
        "wealth": {"type": "integer", "minimum": 0},
        "health": {"type": "integer", "minimum": 0, "maximum": 100},
        "sanity": {"type": "integer", "minimum": 0, "maximum": 100},
        "states": {"type": "object"},
        "item_effects": {"type": "object"},
        "item_effect_records": {"type": "array"},
        "equipped_item_ids": {"type": "array", "items": {"type": "string"}},
        "equipment_slots": {"type": "object"},
        "knowledge": {"type": "array", "items": {"type": "string"}},
        "skills": {"type": "object"},
        "currency": {"type": "string"},
        "inventory_weight": {"type": "number", "minimum": 0},
        "inventory_capacity": {"type": "number", "minimum": 0},
        "inventory": {"type": "array"}
      }
    },
    "items": {"type": "object", "minProperties": 30, "maxProperties": 50},
    "item_uses": {"type": "object", "minProperties": 30, "maxProperties": 50},
    "item_instances": {"type": "object"},
    "scene_inventories": {"type": "object"},
    "container_inventories": {"type": "object"},
    "passages": {"type": "object"},
    "available_actions": {"type": "array", "items": {"type": "string"}},
    "player_intelligence": {"type": "array"},
    "shops": {"type": "object"},
    "peer_trade_offers": {"type": "object"},
    "recent_trade_memories": {"type": "array"},
    "scenes": {"type": "object"},
    "npcs": {"type": "object"},
    "new_events": {"type": "array"}
  }
}
