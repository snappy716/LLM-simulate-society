{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-simulate-society.local/contracts/cognition_decision.schema.json",
  "title": "Bounded LLM decision response",
  "type": "object",
  "additionalProperties": false,
  "required": ["npc_id", "candidate_revision", "selected_action_id", "reason"],
  "properties": {
    "npc_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "selected_action_id": {"type": ["string", "null"]},
    "reason": {"type": "string", "maxLength": 500},
    "dialogue_intent": {"type": ["string", "null"], "maxLength": 200},
    "target_id": {"type": ["string", "null"]},
    "proposed_parameters": {"type": "object"}
  }
}
