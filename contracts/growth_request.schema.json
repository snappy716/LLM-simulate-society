{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "title": "Campus study and personal deck action parameters",
  "required": ["action_id", "parameters"],
  "properties": {
    "action_id": {"enum": ["READ_KNOWLEDGE", "REFLECT_ON_CASE", "SET_STUDY_FOCUS", "CONFIGURE_ACTOR_DECK"]},
    "parameters": {"type": "object", "properties": {
      "topic_id": {"type": "string", "minLength": 1},
      "card_actor_id": {"type": "string", "minLength": 1},
      "card_ids": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string", "minLength": 1}}
    }, "additionalProperties": false}
  },
  "allOf": [
    {"if": {"properties": {"action_id": {"const": "CONFIGURE_ACTOR_DECK"}}},
     "then": {"properties": {"parameters": {"required": ["card_ids"]}}},
     "else": {"properties": {"parameters": {"required": ["topic_id"]}}}}
  ]
}
