{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-simulate-society.local/contracts/combat_character_card.schema.json",
  "title": "Persistent actor represented as a deployed combat character card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "character_card_instance_id", "actor_id", "display_name", "team_id",
    "deployment_state", "row", "allowed_rows", "preferred_row", "deployment_cost",
    "max_health", "max_focus", "defense", "resistance", "speed",
    "physical_power", "technique_power", "cognitive_power", "support_power",
    "base_command_id", "passive_ids", "command_card_ids"
  ],
  "properties": {
    "character_card_instance_id": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "display_name": {"type": "string", "minLength": 1},
    "team_id": {"type": "string", "minLength": 1},
    "deployment_state": {"enum": ["reserve", "deployed", "incapacitated", "withdrawn"]},
    "row": {"type": ["string", "null"], "enum": ["front", "middle", "back", null]},
    "allowed_rows": {
      "type": "array",
      "items": {"enum": ["front", "middle", "back"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "preferred_row": {"enum": ["front", "middle", "back"]},
    "deployment_cost": {"type": "integer", "minimum": 0, "maximum": 6},
    "max_health": {"type": "integer", "minimum": 1},
    "max_focus": {"type": "integer", "minimum": 0},
    "defense": {"type": "integer", "minimum": 0},
    "resistance": {"type": "integer", "minimum": 0},
    "speed": {"type": "integer", "minimum": 0},
    "physical_power": {"type": "integer", "minimum": 0},
    "technique_power": {"type": "integer", "minimum": 0},
    "cognitive_power": {"type": "integer", "minimum": 0},
    "support_power": {"type": "integer", "minimum": 0},
    "base_command_id": {"type": "string", "minLength": 1},
    "passive_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "command_card_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
  }
}
