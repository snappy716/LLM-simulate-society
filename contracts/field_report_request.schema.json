{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus.local/contracts/field_report_request.schema.json",
  "title": "Submit firsthand physical field report inside kernel command",
  "type": "object",
  "required": ["action_id", "parameters"],
  "properties": {
    "action_id": {"const": "SUBMIT_FIELD_REPORT"},
    "parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "expected_task_revision"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "expected_task_revision": {"type": "integer", "minimum": 0}
      }
    }
  }
}
