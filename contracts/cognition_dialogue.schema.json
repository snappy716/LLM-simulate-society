{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-simulate-society.local/contracts/cognition_dialogue.schema.json",
  "title": "Bounded LLM dialogue response",
  "type": "object",
  "additionalProperties": false,
  "required": ["npc_id", "target_id", "candidate_revision", "utterance", "fact_ids_used"],
  "properties": {
    "npc_id": {"type": "string", "minLength": 1},
    "target_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "integer", "minimum": 1},
    "utterance": {"type": "string", "minLength": 1, "maxLength": 160},
    "fact_ids_used": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
