{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-simulate-society.local/contracts/combat_card.schema.json",
  "title": "Actor-bound combat card instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_instance_id", "card_id", "owner_actor_id", "actor_bound", "card_type",
    "command_cost", "target", "range_pattern", "base_power", "effect_ids", "zone"
  ],
  "properties": {
    "card_instance_id": {"type": "string", "minLength": 1},
    "card_id": {"type": "string", "minLength": 1},
    "owner_actor_id": {"type": "string", "minLength": 1},
    "actor_bound": {"const": true},
    "card_type": {"enum": ["attack", "control", "defense", "knowledge", "signature", "support", "technique"]},
    "command_cost": {"type": "integer", "minimum": 0, "maximum": 6},
    "target": {"enum": ["ally", "contextual", "enemy", "self_or_ally"]},
    "range_pattern": {"enum": ["any_ally", "any_enemy", "card_defined", "front_two_enemy_rows", "frontmost_enemy", "same_or_adjacent_ally"]},
    "base_power": {"type": "integer", "minimum": 0},
    "effect_ids": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "zone": {"enum": ["draw", "hand", "discard", "exhaust", "insight"]},
    "retained": {"type": "boolean"}
  }
}
