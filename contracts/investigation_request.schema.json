{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://campus.local/contracts/investigation_request.schema.json",
  "title": "Personal investigation action parameters inside kernel command",
  "type": "object",
  "required": ["action_id", "parameters"],
  "properties": {
    "action_id": {"enum": ["OBSERVE_SCENE", "SEARCH_SCENE", "RECORD_EVIDENCE", "ASK_ABOUT_EVIDENCE", "SHARE_EVIDENCE", "SET_EVIDENCE_DISCLOSURE", "LINK_EVIDENCE"]},
    "parameters": {"type": "object", "properties": {
      "claim_id": {"type": "string", "minLength": 1},
      "target_id": {"type": "string", "minLength": 1},
      "withheld": {"type": "boolean"},
      "claim_ids": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "summary": {"type": "string", "minLength": 1, "maxLength": 200}
    }, "additionalProperties": false}
  },
  "allOf": [
    {"if": {"properties": {"action_id": {"enum": ["RECORD_EVIDENCE", "ASK_ABOUT_EVIDENCE", "SHARE_EVIDENCE", "SET_EVIDENCE_DISCLOSURE"]}}}, "then": {"properties": {"parameters": {"required": ["claim_id"]}}}},
    {"if": {"properties": {"action_id": {"enum": ["ASK_ABOUT_EVIDENCE", "SHARE_EVIDENCE"]}}}, "then": {"properties": {"parameters": {"required": ["target_id"]}}}},
    {"if": {"properties": {"action_id": {"const": "SET_EVIDENCE_DISCLOSURE"}}}, "then": {"properties": {"parameters": {"required": ["withheld"]}}}},
    {"if": {"properties": {"action_id": {"const": "LINK_EVIDENCE"}}}, "then": {"properties": {"parameters": {"required": ["claim_ids", "summary"]}}}}
  ]
}
