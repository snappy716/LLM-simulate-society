{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-simulate-society.local/contracts/forum_task.schema.json",
  "title": "Surface or night forum task",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "forum", "issuer_id", "title", "action_id", "scene_id", "created_day", "expires_day", "state", "lock_revision"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "forum": {"enum": ["surface", "night"]},
    "issuer_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "template_id": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "activity_id": {"type": "string", "minLength": 1},
    "allowed_phases": {
      "type": "array",
      "items": {"enum": ["morning", "afternoon", "evening", "late_night"]},
      "uniqueItems": true
    },
    "scene_id": {"type": "string", "minLength": 1},
    "created_day": {"type": "integer", "minimum": 1},
    "expires_day": {"type": "integer", "minimum": 1},
    "state": {"enum": ["open", "viewed", "considering", "locked", "in_progress", "completed", "failed", "abandoned", "expired"]},
    "assignee_id": {"type": ["string", "null"]},
    "lock_revision": {"type": "integer", "minimum": 0},
    "viewer_ids": {"type": "array", "items": {"type": "string"}},
    "considering_ids": {"type": "array", "items": {"type": "string"}},
    "helper_ids": {"type": "array", "items": {"type": "string"}},
    "required_skill_ids": {"type": "array", "items": {"type": "string"}},
    "required_item_ids": {"type": "array", "items": {"type": "string"}},
    "reward": {"type": "object", "additionalProperties": {"type": "integer"}},
    "tags": {"type": "array", "items": {"type": "string"}}
    ,"preferred_college_ids": {"type": "array", "items": {"type": "string"}}
    ,"preferred_club_ids": {"type": "array", "items": {"type": "string"}}
    ,"npc_claim_phase_index": {"type": "integer", "minimum": 0}
    ,"npc_execute_after_phase_index": {"type": ["integer", "null"], "minimum": 0}
    ,"history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "phase", "kind", "message"],
        "properties": {
          "day": {"type": "integer", "minimum": 1},
          "phase": {"enum": ["morning", "afternoon", "evening", "late_night"]},
          "kind": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
