{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/campus_activity.schema.json",
  "title": "Campus activity definition",
  "type": "object",
  "required": ["id", "profile_id", "action_class", "allowed_phases"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "action_class": {"enum": ["major", "free"]},
    "allowed_phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["morning", "afternoon", "evening", "late_night"]}
    }
  },
  "additionalProperties": false
}
